{
  "manifest_version": 3,
  "name": "Cek Pesan Pajak — Pelindung WhatsApp Web",
  "version": "1.2.0",
  "description": "Ekstensi untuk membantu memeriksa pesan WhatsApp mengatasnamakan Pajak (DJP) secara langsung agar terhindar dari file .apk dan tautan palsu.",
  "permissions": ["activeTab"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cek Pesan Pajak"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
